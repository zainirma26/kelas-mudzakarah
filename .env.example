# Salin menjadi .env lalu isi. File .env TIDAK ikut di-upload ke GitHub (ada di .gitignore).
# Dipakai oleh APK (lewat scripts/gen-env.js) saat build.

# Alamat server token (dari Render). Harus https://
SERVER_URL=https://kelas-online-server.onrender.com

# Opsional: alamat file JSON {"server":"https://..."} untuk pindah server tanpa build ulang APK
CONFIG_URL=
